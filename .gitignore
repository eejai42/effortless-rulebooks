# Rulebook cache (user cache for offline mode - NOT the repo cache)
effortless-rulebook/.cache/

# Environment files (secrets)
# .env is ignored, but .env.example and effortless.env are whitelisted
.env
!.env.example
!effortless.env
!**/effortless.env

# Note: bases/*/ is NOT gitignored - it contains the repo cache
# that ships with the repo for cold-start Docker support
rulebook-examples/legacy-runner/testing/_substrate_results.json
rulebook-examples/legacy-runner/execution-substrates/cobol/erb_test

# Admin portal: per-machine state, proxy log
admin-portal/.portal-state.json
admin-portal/.proxy.log
**/.proxy.log
**/.applied-manifest.json
**/_substrate_results.json
**/.build-manifest.json
rulebook-examples/legacy-runner/postgres/.applied-manifest.json
rulebook-examples/legacy-runner/postgres/.build-manifest.json

# Compiled test binaries (regenerated by substrate builds)
rulebook-examples/legacy-runner/execution-substrates/golang/erb_test

# Orphaned saved-webpage assets (no longer used, kept out of future commits)
effortless-rulebook-pipeline_files/

# Community-event-planner walkthrough media (intermediate; keep on disk, off git)
rulebook-examples/community-event-planner/walkthrough/_audio/
rulebook-examples/community-event-planner/walkthrough/_video/
rulebook-examples/community-event-planner/walkthrough/*.mp4
rulebook-examples/community-event-planner/walkthrough/*.webm
rulebook-examples/talisman-basic/bootstrap/jessica-talisman-git-ignored-source.txt
**/**jessica-talisman**
rulebook-examples/simpsons-paradox/temp.txt

# Root explorer local build and runtime output
/app/dist/
/.run/

# generated rulebook-editor edit journals (pending-edit logs, never a second hub)
**/effortless-rulebook/*.uncommitted-*.json

# scratch that must never be committed (cr-08)
**/.app-launch.log
**/*.bak

# CLI build error reports are per-run scratch (cr-08)
**/errors.json
**/postgres/errors.txt
