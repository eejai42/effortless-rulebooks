{
  "Name": "bit-calculator",
  "Description": "A 4-bit ripple-carry adder as pure rulebook data. 29 wires + 12 gate truth rows. Every result bit is a LOOKUP into a gate truth table keyed on the two driver wires' own computed bits. No arithmetic is stored and no bespoke function exists: ComputedBit is a plain Excel IF over two INDEX/MATCH lookups that recurse down the AWire/BWire self-FKs to the seeded inputs.",
  "__meta__": {
    "schema": [
      {"name": "MetaKey", "datatype": "string", "type": "raw", "nullable": false, "Description": "MetaKey"},
      {"name": "Name", "datatype": "string", "type": "calculated", "nullable": true, "formula": "={{MetaKey}}", "Description": "Name"},
      {"name": "ValueType", "datatype": "string", "type": "raw", "nullable": true, "Description": "ValueType"},
      {"name": "StringValue", "datatype": "string", "type": "raw", "nullable": true, "Description": "StringValue"},
      {"name": "JsonValue", "datatype": "string", "type": "raw", "nullable": true, "Description": "JsonValue"}
    ],
    "data": [
      {"MetaKey": "tagline", "ValueType": "string", "StringValue": "29 wires. 12 truth rows. Arithmetic emerges. No bespoke code.", "JsonValue": null}
    ]
  },
  "GateTypes": {
    "schema": [
      {"name": "GateId", "datatype": "string", "type": "raw", "nullable": false, "Description": "GateId"},
      {"name": "Name", "datatype": "string", "type": "calculated", "nullable": true, "formula": "={{GateId}}", "Description": "Name"},
      {"name": "Symbol", "datatype": "string", "type": "raw", "nullable": true, "Description": "Human-readable gate symbol"},
      {"name": "Description", "datatype": "string", "type": "raw", "nullable": true, "Description": "What the gate does"}
    ],
    "data": [
      {"GateId": "gate-xor", "Symbol": "XOR", "Description": "Exclusive OR of two bits."},
      {"GateId": "gate-and", "Symbol": "AND", "Description": "Logical AND of two bits."},
      {"GateId": "gate-or", "Symbol": "OR", "Description": "Logical OR of two bits."}
    ]
  },
  "GateTruthRows": {
    "schema": [
      {"name": "TruthRowId", "datatype": "string", "type": "raw", "nullable": false, "Description": "gate|in0|in1 -- the PK IS the lookup key"},
      {"name": "Name", "datatype": "string", "type": "calculated", "nullable": true, "formula": "={{TruthRowName}}", "Description": "Name"},
      {"name": "TruthRowName", "datatype": "string", "type": "raw", "nullable": true, "Description": "Readable truth-table line"},
      {"name": "Gate", "datatype": "string", "type": "relationship", "nullable": false, "RelatedTo": "GateTypes", "Description": "Which gate"},
      {"name": "In0", "datatype": "integer", "type": "raw", "nullable": false, "Description": "Left input bit"},
      {"name": "In1", "datatype": "integer", "type": "raw", "nullable": false, "Description": "Right input bit"},
      {"name": "OutBit", "datatype": "integer", "type": "raw", "nullable": false, "Description": "Output bit for this input pair"}
    ],
    "data": [
      {"TruthRowId": "gate-xor|0|0", "TruthRowName": "XOR: 0 XOR 0 = 0", "Gate": "gate-xor", "In0": 0, "In1": 0, "OutBit": 0},
      {"TruthRowId": "gate-xor|0|1", "TruthRowName": "XOR: 0 XOR 1 = 1", "Gate": "gate-xor", "In0": 0, "In1": 1, "OutBit": 1},
      {"TruthRowId": "gate-xor|1|0", "TruthRowName": "XOR: 1 XOR 0 = 1", "Gate": "gate-xor", "In0": 1, "In1": 0, "OutBit": 1},
      {"TruthRowId": "gate-xor|1|1", "TruthRowName": "XOR: 1 XOR 1 = 0", "Gate": "gate-xor", "In0": 1, "In1": 1, "OutBit": 0},
      {"TruthRowId": "gate-and|0|0", "TruthRowName": "AND: 0 AND 0 = 0", "Gate": "gate-and", "In0": 0, "In1": 0, "OutBit": 0},
      {"TruthRowId": "gate-and|0|1", "TruthRowName": "AND: 0 AND 1 = 0", "Gate": "gate-and", "In0": 0, "In1": 1, "OutBit": 0},
      {"TruthRowId": "gate-and|1|0", "TruthRowName": "AND: 1 AND 0 = 0", "Gate": "gate-and", "In0": 1, "In1": 0, "OutBit": 0},
      {"TruthRowId": "gate-and|1|1", "TruthRowName": "AND: 1 AND 1 = 1", "Gate": "gate-and", "In0": 1, "In1": 1, "OutBit": 1},
      {"TruthRowId": "gate-or|0|0", "TruthRowName": "OR: 0 OR 0 = 0", "Gate": "gate-or", "In0": 0, "In1": 0, "OutBit": 0},
      {"TruthRowId": "gate-or|0|1", "TruthRowName": "OR: 0 OR 1 = 1", "Gate": "gate-or", "In0": 0, "In1": 1, "OutBit": 1},
      {"TruthRowId": "gate-or|1|0", "TruthRowName": "OR: 1 OR 0 = 1", "Gate": "gate-or", "In0": 1, "In1": 0, "OutBit": 1},
      {"TruthRowId": "gate-or|1|1", "TruthRowName": "OR: 1 OR 1 = 1", "Gate": "gate-or", "In0": 1, "In1": 1, "OutBit": 1}
    ]
  },
  "Wires": {
    "schema": [
      {"name": "WireId", "datatype": "string", "type": "raw", "nullable": false, "Description": "WireId"},
      {"name": "Name", "datatype": "string", "type": "calculated", "nullable": true, "formula": "={{WireName}}", "Description": "Name"},
      {"name": "WireName", "datatype": "string", "type": "raw", "nullable": true, "Description": "Human-readable wire name"},
      {"name": "SeededBit", "datatype": "integer", "type": "raw", "nullable": true, "Description": "Set ONLY on input wires. The app writes these; nothing else."},
      {"name": "Gate", "datatype": "string", "type": "relationship", "nullable": true, "RelatedTo": "GateTypes", "Description": "The gate driving this wire (null for inputs)"},
      {"name": "AWire", "datatype": "string", "type": "relationship", "nullable": true, "RelatedTo": "Wires", "Description": "self-FK: the wire feeding this gate's left input"},
      {"name": "BWire", "datatype": "string", "type": "relationship", "nullable": true, "RelatedTo": "Wires", "Description": "self-FK: the wire feeding this gate's right input"},
      {"name": "ABit", "datatype": "integer", "type": "lookup", "nullable": true, "RelatedTo": "Wires", "formula": "=IF({{AWire}}<>\"\", INDEX(Wires!{{ComputedBit}}, MATCH({{AWire}}, Wires!{{WireId}}, 0)), \"\")", "Description": "The left driver wire's computed bit. Blank when this wire has no driver (a seeded input)."},
      {"name": "BBit", "datatype": "integer", "type": "lookup", "nullable": true, "RelatedTo": "Wires", "formula": "=IF({{BWire}}<>\"\", INDEX(Wires!{{ComputedBit}}, MATCH({{BWire}}, Wires!{{WireId}}, 0)), \"\")", "Description": "The right driver wire's computed bit. Blank when this wire has no driver (a seeded input)."},
      {"name": "TruthKey", "datatype": "string", "type": "calculated", "nullable": true, "formula": "=IF({{Gate}}<>\"\", CONCAT({{Gate}}, \"|\", {{ABit}}, \"|\", {{BBit}}), \"\")", "Description": "Gate plus its two settled input bits; blank on a seeded input wire (no gate)."},
      {"name": "GateOut", "datatype": "integer", "type": "lookup", "nullable": true, "RelatedTo": "GateTruthRows", "formula": "=IF({{Gate}}<>\"\", INDEX(GateTruthRows!{{OutBit}}, MATCH({{TruthKey}}, GateTruthRows!{{TruthRowId}}, 0)), \"\")", "Description": "The gate's output bit from the truth table; blank on a seeded input wire (no gate)."},
      {"name": "ComputedBit", "datatype": "integer", "type": "calculated", "nullable": true, "formula": "=IF({{SeededBit}}<>\"\", {{SeededBit}}, {{GateOut}})", "Description": "THE ANSWER for this wire: its seeded bit if an input, else its gate's output."},
      {"name": "ADepth", "datatype": "integer", "type": "lookup", "nullable": true, "RelatedTo": "Wires", "formula": "=IF({{AWire}}<>\"\", INDEX(Wires!{{Depth}}, MATCH({{AWire}}, Wires!{{WireId}}, 0)), 0)", "Description": "Left driver's depth; 0 when there is no driver."},
      {"name": "BDepth", "datatype": "integer", "type": "lookup", "nullable": true, "RelatedTo": "Wires", "formula": "=IF({{BWire}}<>\"\", INDEX(Wires!{{Depth}}, MATCH({{BWire}}, Wires!{{WireId}}, 0)), 0)", "Description": "Right driver's depth; 0 when there is no driver."},
      {"name": "Depth", "datatype": "integer", "type": "calculated", "nullable": true, "formula": "=IF({{SeededBit}}<>\"\", 0, 1 + MAX({{ADepth}}, {{BDepth}}))", "Description": "Logic level: 0 for inputs, else one deeper than its deepest driver. The DAG computing its own depth."}
    ],
    "data": [
